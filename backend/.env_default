# -------------------------------------------------------------------------
# This file lists the server environment variables and their default values
# -------------------------------------------------------------------------


# Path to SAM2 root containing the checkpoints folder
APP_ROOT="/opt/sam2"

API_URL="http://localhost:7263"

#Options for the `MODEL_SIZE` argument are "tiny", "small", "base_plus" (default), and "large".
MODEL_SIZE="base_plus"

FFMPEG_NUM_THREADS= "1"

# Path for all data used in API
DATA_PATH="../data"


# Transcode received videos to make sure videos returned to the app are all in
# the same format, duration, resolution, fps.
TRANSCODE_VIDEOS="False"


# Max duration an uploaded video can have in seconds.
MAX_UPLOAD_VIDEO_DURATION="10"

# DEFAULT_VIDEO_PATH: Optionnal. If set, it will define which video is returned by the default video query for desktop
# Example:
# DEFAULT_VIDEO_PATH="gallery/default_video.mp4"


OFFLOAD_VIDEO_TO_CPU="False"

SAM2_FORCE_CPU_DEVICE="0"

VIDEO_ENCODE_SEEK_TIME="0"


# ffmpeg/video encode settings
VIDEO_ENCODE_CODEC="libx264"
VIDEO_ENCODE_CRF="23"
VIDEO_ENCODE_FPS="24"
VIDEO_ENCODE_MAX_WIDTH="1280"
VIDEO_ENCODE_MAX_HEIGHT="720"
VIDEO_ENCODE_VERBOSE="False"